INVESTPILOT_APP_VERSION=0.2.1
INVESTPILOT_RELEASE_CHANNEL=public-beta

# 数据源策略
# auto: 优先 FastAPI，失败后回退
# fastapi: 强制真实接口
# mock: 强制使用 mock
INVESTPILOT_DATA_SOURCE=auto

# 本地联调时填写 FastAPI 地址；仅部署前端演示版时可留空
INVESTPILOT_FASTAPI_BASE_URL=http://127.0.0.1:8000

# 前端请求超时时间，联调 AKShare 时建议适当放大
INVESTPILOT_REQUEST_TIMEOUT_MS=45000
